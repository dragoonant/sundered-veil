# API keys — never commit
.hf_token
.elevenlabs_key
*.key

# Full-resolution art masters stay out of the repo (downscaled copies go in art/)
# The card back is the exception: it is hand-supplied branding, not something
# tools/gen-art.mjs can regenerate, so the master ships with the repo — and the
# WebP the game draws is derived from it, so that ships too.
art-masters/*
!art-masters/cardback-master.jpg

# Import scratch — work packets may carry third-party names; never commit
scratch/
import-packets/

# OS noise
Thumbs.db
desktop.ini

# Generated assets SHIP with the repo: GitHub Pages serves the repo root as-is, so the
# deployed game has exactly the art and sound that is committed. Only the delivery
# formats are tracked (WebP, the two shrunk end-of-match MP4s, MP3). Masters, PNG
# intermediates, contact sheets, test renders and logs stay out; regenerate via
# tools/gen-art.mjs, tools/gen-fx.mjs, tools/gen-sfx.mjs, tools/gen-music.mjs.
# Run `node tools/check-pages.mjs` to see what the live site would be missing.
art/*
!art/*.webp
!art/victory.mp4
!art/defeat.mp4
!art/fx/
art/fx/*
!art/fx/*.webp
sfx/*
!sfx/*.mp3
art-gen.log
art-regen.log
art-gen-212.log
art-test/
art-test2/

# Superseded art generations (v1 pre-rewrite, v2 pre-fix-pass) — regenerate via tools/gen-art.mjs
art-old-v1/
art-v2-superseded/
node_modules/
