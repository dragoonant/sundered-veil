# API keys — never commit
.hf_token
.elevenlabs_key
*.key

# Full-resolution art masters stay out of the repo (downscaled copies go in art/)
# The card back is the exception: it is hand-supplied branding, not something
# tools/gen-art.mjs can regenerate, so the master ships with the repo — and the
# WebP the game draws is derived from it, so that ships too.
art-masters/*
!art-masters/cardback-master.jpg

# Import scratch — work packets may carry third-party names; never commit
scratch/
import-packets/

# Local playtesting name/text override (tools/gen-source-names.mjs) — carries source
# material display text. Ignored on every branch except playtest (see below).

# OS noise
Thumbs.db
desktop.ini

# PLAYTEST BRANCH ONLY: art/, sfx/ and data/source-local.js are committed here so a
# phone clone (Working Copy) runs the full game. This branch never merges to main and
# must be deleted (history purged) before the repo is ever made public. See NOTICE.md.
art/thumbs/
art-gen.log
art-regen.log
art-gen-212.log
art-test/
art-test2/

# Superseded art generations (v1 pre-rewrite, v2 pre-fix-pass) — regenerate via tools/gen-art.mjs
art-old-v1/
art-v2-superseded/
node_modules/
