# API keys — never commit
.hf_token
.elevenlabs_key
*.key

# Full-resolution art masters stay out of the repo (downscaled copies go in art/)
# The card back is the exception: it is hand-supplied branding, not something
# tools/gen-art.mjs can regenerate, so the master ships with the repo.
art-masters/*
!art-masters/cardback-master.jpg

# Import scratch — work packets may carry third-party names; never commit
scratch/
import-packets/

# Local playtesting name/text override (tools/gen-source-names.mjs) — carries source
# material display text; never commit, never deploy
data/source-local.js

# OS noise
Thumbs.db
desktop.ini

# Generated assets stay out of the repo (regenerate via tools/gen-art.mjs, tools/gen-sfx.mjs)
# art/cardback.jpg is the exception, for the same reason as its master above:
# no prompt produces it, so without it a fresh clone has no card back at all.
art/*
!art/cardback.jpg
sfx/
art-gen.log
art-regen.log
art-test/
art-test2/

# Superseded art generations (v1 pre-rewrite, v2 pre-fix-pass) — regenerate via tools/gen-art.mjs
art-old-v1/
art-v2-superseded/
